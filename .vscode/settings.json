{
    "doxdocgen.file.copyrightTag": [
        "@copyright Copyright (c) Pradosh {year}"
    ],
    "doxdocgen.generic.authorEmail": "pradoshgame@gmail.com",
    "doxdocgen.generic.authorName": "Pradosh",
    "doxdocgen.generic.authorTag": "@author {author} ({email})",
    "clangd.arguments": [
        "--compile-commands-dir=${workspaceFolder}/source",
        "--background-index-priority=low",
        "--limit-results=100",
        "-j=4"
    ],
    "files.watcherExclude": {
    "**/fs_root/**": true,
    "**/fs_root.bak/**": true,
    "**/docs/**": true,
    "**/firmware/**": true,
    "**/limine/**": true,
    "**/obj/**": true,
    "**/*.o": true,
    "**/*.iso": true
    },
    "search.exclude": {
    "**/fs_root": true,
    "**/docs": true
    }
}